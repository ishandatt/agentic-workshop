# --- Models (served by native Ollama on :11434) ---
# This file is the single knob for model choice: setup.sh pulls whatever is
# named here, and every Python module reads it via common/config.py. To swap
# models, edit the line below and re-run ./setup.sh.
CHAT_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# --- Database (Podman, see scripts/db.sh) ---
DATABASE_URL=postgresql://workshop:workshop@localhost:5432/workshop

# --- Metrics: reference cloud pricing for cost intuition (USD per 1M tokens) ---
# Defaults ≈ a mid-tier frontier model. Change them and watch estimates move.
REF_PRICE_INPUT_PER_1M=3.00
REF_PRICE_OUTPUT_PER_1M=15.00
